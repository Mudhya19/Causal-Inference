knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# ============================================================
#  KAUSAL INFERENSI — PC ALGORITHM & GES
#  Dataset : abortion (causaldata)
#  Package : pcalg, graph, Rgraphviz
# ============================================================
# ── 0. INSTALASI ─────────────────────────────────────────────
pkgs_cran <- c("causaldata", "pcalg", "BiocManager", "corrplot", "ggplot2")
for (p in pkgs_cran) {
if (!requireNamespace(p, quietly = TRUE)) install.packages(p)
}
# Bioconductor dependencies untuk visualisasi graph
if (!requireNamespace("graph",      quietly = TRUE)) BiocManager::install("graph")
if (!requireNamespace("Rgraphviz",  quietly = TRUE)) BiocManager::install("Rgraphviz")
if (!requireNamespace("RBGL",       quietly = TRUE)) BiocManager::install("RBGL")
library(causaldata)
library(pcalg)
library(graph)
library(Rgraphviz)
library(corrplot)
# ── 1. EKSPLORASI DATA ────────────────────────────────────────
data("abortion", package = "causaldata")
cat("=== STRUKTUR DATA ===\n");  str(abortion)
cat("\n=== 6 BARIS PERTAMA ===\n"); print(head(abortion))
cat("\n=== RINGKASAN STATISTIK ===\n"); print(summary(abortion))
cat("\n=== MISSING VALUES PER KOLOM ===\n"); print(colSums(is.na(abortion)))
# ── 2. PREPROCESSING ─────────────────────────────────────────
#
# Langkah:
#   a. Pilih kolom numerik (buang identifier kategorikal: state)
#   b. Pertahankan 'year' sebagai kovariat temporal numerik
#   c. Buang baris dengan NA
#   d. Standardisasi → mean=0, sd=1
#      (PC gaussCItest & GES GaussL0pen sensitif terhadap skala)
#
df_raw <- abortion[, sapply(abortion, is.numeric)]   # hanya numerik
# Variabel identitas murni (bukan substantif) dibuang
id_cols <- c("state_fips", "fip", "fips", "id")      # sesuaikan jika ada
df_raw  <- df_raw[, !colnames(df_raw) %in% id_cols]
df_clean  <- na.omit(df_raw)                          # hapus NA
df_scaled <- as.data.frame(scale(df_clean))           # standardisasi
n         <- nrow(df_scaled)          # jumlah observasi
p         <- ncol(df_scaled)          # jumlah variabel
var_names <- colnames(df_scaled)      # nama variabel
cat("\n=== VARIABEL TERPILIH ===\n"); cat(var_names, "\n")
cat("Obs:", n, "| Var:", p, "\n")
# Visualisasi matriks korelasi sebelum analisis kausal
corrplot(cor(df_scaled),
method  = "color", type = "upper",
tl.cex  = 0.8, tl.col = "black",
title   = "Korelasi Antar Variabel (Pre-Causal)",
mar     = c(0,0,2,0))
# ============================================================
#  3. PC ALGORITHM
# ============================================================
#
# Sufficient Statistic untuk data Gaussian:
#   suffStat berisi matriks korelasi (C) dan n.
#   gaussCItest menguji H0: X ⊥⊥ Y | Z dengan statistik
#   Fisher's Z-transform pada partial correlation.
#
# Parameter kunci:
#   indepTest = gaussCItest → uji CI berbasis korelasi parsial
#   alpha     = 0.05        → taraf signifikansi; lebih kecil
#                              menghasilkan graf lebih sparse
#   skel.method = "stable"  → urutan variabel tidak mempengaruhi
#                              skeleton (algoritma PC-stable)
#   u2pd = "relaxed"        → jika orientasi bertentangan,
#                              gunakan pendekatan "relaxed"
#
cat("\n\n============================================================\n")
cat(" MENJALANKAN PC ALGORITHM\n")
cat("============================================================\n")
suffStat_pc <- list(C = cor(df_scaled), n = n)
set.seed(42)
pc_fit <- pc(
suffStat    = suffStat_pc,
indepTest   = gaussCItest,
alpha       = 0.05,
p           = p,
labels      = var_names,
skel.method = "stable",      # PC-stable: order-independent skeleton
u2pd        = "relaxed",     # resolusi konflik orientasi
maj.rule    = FALSE,         # FALSE = orientasi konservatif
verbose     = FALSE
)
cat("=== SUMMARY PC ALGORITHM ===\n")
summary(pc_fit)
# Adjacency matrix dari CPDAG PC
# amat[i,j]=1, amat[j,i]=0 → edge i → j  (directed)
# amat[i,j]=1, amat[j,i]=1 → edge i ─ j  (undirected)
amat_pc <- as(pc_fit@graph, "matrix")
cat("\n=== ADJACENCY MATRIX (CPDAG) PC ===\n")
print(amat_pc)
# ─── Hitung statistik graph PC ──────────────────────────────
n_directed   <- sum(amat_pc == 1 & t(amat_pc) == 0)
n_undirected <- sum(amat_pc == 1 & t(amat_pc) == 1) / 2
cat(sprintf("\nEdge directed  (→): %d\n", n_directed))
cat(sprintf("Edge undirected (─): %d\n", n_undirected))
# Plot CPDAG PC
dev.new(width=10, height=7)
plot(pc_fit, main  = "CPDAG – PC Algorithm (α = 0.05)")
# ============================================================
#  4. GES (Greedy Equivalence Search)
# ============================================================
#
# GES memerlukan objek "Score" bukan suffStat.
# GaussL0penObsScore menggunakan skor BIC Gaussian:
#   Score(G) = log-likelihood(G) – lambda * |params|
#
# Parameter kunci:
#   lambda = 0.5*log(n) → penalti BIC standar (konsisten)
#              Nilai lebih besar → graf lebih sparse
#              Nilai lebih kecil → graf lebih dense
#   intercept = FALSE   → asumsikan data telah distandarisasi
#
# Fase GES:
#   Forward  : mulai dari graf kosong, tambah edge max-score
#   Backward : hapus edge yang meningkatkan skor
#   Turning  : orientasi sisa edge
#
cat("\n\n============================================================\n")
cat(" MENJALANKAN GES\n")
cat("============================================================\n")
score_ges <- new(
"GaussL0penObsScore",
data      = df_scaled,
lambda    = 0.5 * log(n),   # penalti BIC: konsisten secara asimtotik
intercept = FALSE            # data sudah distandarisasi
)
set.seed(42)
ges_fit <- ges(
score   = score_ges,
labels  = var_names,
verbose = FALSE
)
cat("=== SUMMARY GES ===\n")
print(ges_fit)
# Adjacency matrix CPDAG GES
amat_ges <- as(ges_fit$essgraph, "matrix")
cat("\n=== ADJACENCY MATRIX (CPDAG) GES ===\n")
print(amat_ges)
# ─── Statistik graph GES ────────────────────────────────────
n_directed_ges   <- sum(amat_ges == 1 & t(amat_ges) == 0)
n_undirected_ges <- sum(amat_ges == 1 & t(amat_ges) == 1) / 2
cat(sprintf("\nEdge directed  (→): %d\n", n_directed_ges))
cat(sprintf("Edge undirected (─): %d\n", n_undirected_ges))
# Plot CPDAG GES
dev.new(width=10, height=7)
plot(ges_fit$essgraph, main  = "CPDAG – GES (Greedy Equivalence Search)")
# ============================================================
#  6. ESTIMASI SKELETON & IDENTIFIKASI COLLIDER  (Soal C)
# ============================================================
cat("\n\n============================================================\n")
cat(" ESTIMASI SKELETON\n")
cat("============================================================\n")
# Jalankan skeleton secara terpisah untuk mengakses sepset
skel_fit <- skeleton(
suffStat    = suffStat_pc,
indepTest   = gaussCItest,
alpha       = 0.05,
p           = p,
labels      = var_names,
method      = "stable"
)
amat_skel <- as(skel_fit@graph, "matrix")
sep_sets  <- skel_fit@sepset           # sep_sets[[i]][[j]] = Z: X_i ⊥⊥ X_j | Z
cat("=== ADJACENCY MATRIX SKELETON (Undirected) ===\n")
print(amat_skel)
cat(sprintf("\nTotal edges skeleton: %d\n", sum(amat_skel)/2))
# Plot Skeleton
dev.new(width=10, height=7)
plot(skel_fit, main  = "Skeleton – Undirected Graph (α = 0.05)")
# ── FUNGSI UTAMA: Identifikasi Collider dari Skeleton ────────
#
# Prinsip V-structure (Collider):
#   Triple A ─ X ─ B (unshielded: A dan B tidak bertetangga)
#   → X adalah COLLIDER jika X ∉ sepset(A, B)
#   → X bukan collider jika X ∈ sepset(A, B)
#
# Intuisi:
#   Jika A ⊥⊥ B | Z dan X tidak ada di Z,
#   itu berarti mengkondisikan X "membuka" path A─X─B,
#   yang merupakan ciri khas collider.
#
identify_colliders_from_skeleton <- function(amat_skel, sep_sets, var_names) {
p <- nrow(amat_skel)
result <- list(
collider     = data.frame(A=character(), X=character(), B=character(),
SepSet=character(), stringsAsFactors=FALSE),
non_collider = data.frame(A=character(), X=character(), B=character(),
SepSet=character(), stringsAsFactors=FALSE)
)
for (x in seq_len(p)) {
# Tetangga X di skeleton
adj_x <- which(amat_skel[x, ] != 0)
if (length(adj_x) < 2) next
pairs <- combn(adj_x, 2, simplify = FALSE)
for (pair in pairs) {
a <- pair[1]; b <- pair[2]
# Syarat unshielded triple: A dan B tidak terhubung langsung
if (amat_skel[a, b] != 0) next
# Ambil separation set; coba kedua arah
sep_ab <- sep_sets[[a]][[b]]
if (is.null(sep_ab)) sep_ab <- sep_sets[[b]][[a]]
sep_str <- if (is.null(sep_ab) || length(sep_ab) == 0) {
"{}"
} else {
paste0("{", paste(var_names[sep_ab], collapse = ", "), "}")
}
# X ∉ sepset → COLLIDER
x_not_in_sep <- is.null(sep_ab) || !(x %in% sep_ab)
if (x_not_in_sep) {
result$collider <- rbind(result$collider,
data.frame(A = var_names[a], X = var_names[x], B = var_names[b],
SepSet = sep_str, stringsAsFactors = FALSE))
} else {
result$non_collider <- rbind(result$non_collider,
data.frame(A = var_names[a], X = var_names[x], B = var_names[b],
SepSet = sep_str, stringsAsFactors = FALSE))
}
}
}
return(result)
}
collider_result <- identify_colliders_from_skeleton(amat_skel, sep_sets, var_names)
cat("\n=== COLLIDER TERIDENTIFIKASI (X ∉ sepset) ===\n")
if (nrow(collider_result$collider) == 0) {
cat("Tidak ada collider teridentifikasi dari skeleton.\n")
} else {
for (i in seq_len(nrow(collider_result$collider))) {
r <- collider_result$collider[i, ]
cat(sprintf("  %d. %s --> %s <-- %s  |  sepset = %s\n",
i, r$A, r$X, r$B, r$SepSet))
}
}
cat("\n=== NON-COLLIDER (X ∈ sepset) ===\n")
if (nrow(collider_result$non_collider) == 0) {
cat("Tidak ada non-collider.\n")
} else {
for (i in seq_len(nrow(collider_result$non_collider))) {
r <- collider_result$non_collider[i, ]
cat(sprintf("  %d. %s -- %s -- %s  |  sepset = %s\n",
i, r$A, r$X, r$B, r$SepSet))
}
}
# ── Verifikasi Collider dengan CPDAG PC ──────────────────────
cat("\n=== VERIFIKASI COLLIDER DARI CPDAG (PC) ===\n")
cat("(amat[a,x]=1 & amat[x,a]=0) AND (amat[b,x]=1 & amat[x,b]=0)\n")
cat("Format: A → X ← B\n\n")
verified <- 0
for (x in seq_len(p)) {
adj_x <- which(amat_skel[x, ] != 0)
if (length(adj_x) < 2) next
pairs <- combn(adj_x, 2, simplify = FALSE)
for (pair in pairs) {
a <- pair[1]; b <- pair[2]
if (amat_skel[a, b] != 0) next
# Directed: a→x DAN b→x
if (amat_pc[a, x] == 1 && amat_pc[x, a] == 0 &&
amat_pc[b, x] == 1 && amat_pc[x, b] == 0) {
cat(sprintf("  ✔ %s → %s ← %s\n", var_names[a], var_names[x], var_names[b]))
verified <- verified + 1
}
}
}
if (verified == 0) cat("  Tidak ada v-structure terorientasi penuh di CPDAG.\n")
# ============================================================
#  5. PERBANDINGAN PC vs GES
# ============================================================
cat("\n\n============================================================\n")
cat(" PERBANDINGAN PC vs GES\n")
cat("============================================================\n")
compare_graphs <- function(am1, am2, name1="PC", name2="GES") {
# Edge di PC: posisi (i,j) di mana am1[i,j]=1
edges1 <- which(am1 == 1, arr.ind = TRUE)
edges2 <- which(am2 == 1, arr.ind = TRUE)
# Konversi ke set string untuk perbandingan mudah
e1_set <- apply(edges1, 1, paste, collapse="-")
e2_set <- apply(edges2, 1, paste, collapse="-")
shared  <- intersect(e1_set, e2_set)
only1   <- setdiff(e1_set, e2_set)
only2   <- setdiff(e2_set, e1_set)
cat(sprintf("Edge total %s : %d\n", name1, nrow(edges1)))
cat(sprintf("Edge total %s : %d\n", name2, nrow(edges2)))
cat(sprintf("Edge bersama     : %d\n", length(shared)))
cat(sprintf("Hanya di %s    : %d\n", name1, length(only1)))
cat(sprintf("Hanya di %s   : %d\n", name2, length(only2)))
# Precision & Recall (GES sebagai referensi)
precision <- length(shared) / nrow(edges1)
recall    <- length(shared) / nrow(edges2)
cat(sprintf("\nPrecision (PC vs GES): %.3f\n", precision))
cat(sprintf("Recall    (PC vs GES): %.3f\n", recall))
}
compare_graphs(amat_pc, amat_ges)
# ============================================================
#  7. RINGKASAN OUTPUT
# ============================================================
cat("\n\n============================================================\n")
cat(" RINGKASAN HASIL\n")
cat("============================================================\n")
cat(sprintf("%-30s %5s %5s\n", "Metrik", "PC", "GES"))
cat(rep("-", 42), "\n", sep="")
cat(sprintf("%-30s %5d %5d\n", "Total edges",
sum(amat_pc  > 0, na.rm=TRUE),
sum(amat_ges > 0, na.rm=TRUE)))
cat(sprintf("%-30s %5d %5d\n", "Directed edges",
n_directed, n_directed_ges))
cat(sprintf("%-30s %5d %5d\n", "Undirected edges",
n_undirected, n_undirected_ges))
cat(sprintf("%-30s %5d %5s\n", "Collider teridentifikasi",
nrow(collider_result$collider), "—"))
savehistory("C:/Users/IT/data science/Causal Inference/UTS_Causal_Inference_Final.Rhistory")
