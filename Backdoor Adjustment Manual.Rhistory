library(pcalg)        # PC Algorithm dan GES
library(graph)        # manipulasi object graph
library(Rgraphviz)    # visualisasi DAG/CPDAG
library(SMPracticals) # dataset mathmarks
library(bnlearn)      # PC Algorithm untuk mixed data
library(ggplot2)
library(gridExtra)
data(gmG)
# Struktur data
cat("Dimensi data:", nrow(gmG$x), "baris x", ncol(gmG$x), "kolom\n")
cat("Nama variabel:", colnames(gmG$x), "\n")
# Ringkasan statistik deskriptif
summary(gmG$x)
# Heatmap korelasi antar variabel
corr_mat <- round(cor(gmG$x), 2)
# Visualisasi korelasi
par(mar = c(2, 2, 3, 2))
corrplot_data <- corr_mat
image(1:8, 1:8, corrplot_data[, 8:1],
col  = colorRampPalette(c("#d73027", "white", "#1a9850"))(100),
xaxt = "n", yaxt = "n",
main = "Matriks Korelasi — Dataset gmG",
xlab = "", ylab = "")
axis(1, at = 1:8, labels = colnames(gmG$x), las = 2, cex.axis = 0.8)
axis(2, at = 1:8, labels = rev(colnames(gmG$x)), las = 1, cex.axis = 0.8)
for (i in 1:8) for (j in 1:8)
text(i, 9 - j, corrplot_data[i, 9 - j], cex = 0.7)
# Visualisasi True DAG (struktur kausal sesungguhnya)
plot(gmG$g, main = "True DAG — Dataset gmG")
# Siapkan sufficient statistics untuk gaussCItest
# gaussCItest membutuhkan: correlation matrix (C) dan sample size (n)
allStat <- list(
C = cor(gmG$x),      # matriks korelasi
n = nrow(gmG$x)      # jumlah observasi
)
cat("Sample size:", allStat$n, "\n")
cat("Dimensi correlation matrix:", dim(allStat$C), "\n")
# Jalankan PC Algorithm
set.seed(42)
pc_gmG <- pc(
suffStat  = allStat,
indepTest = gaussCItest,   # CI test untuk data Gaussian
p         = ncol(gmG$x),   # jumlah variabel
alpha     = 0.01           # threshold signifikansi
)
# Tampilkan ringkasan hasil
summary(pc_gmG)
# Jalankan ulang dengan verbose untuk melihat proses
pc_gmG_verbose <- pc(
suffStat  = allStat,
indepTest = gaussCItest,
p         = ncol(gmG$x),
alpha     = 0.01,
verbose   = TRUE           # tampilkan log proses
)
data(gmD)
# Struktur data
cat("Dimensi data:", nrow(gmD$x), "baris x", ncol(gmD$x), "kolom\n")
cat("Jumlah kategori tiap variabel:", apply(gmD$x, 2, max), "\n")
# Visualisasi distribusi frekuensi setiap variabel
par(mfrow = c(2, 3))
for (i in 1:ncol(gmD$x)) {
barplot(
table(gmD$x[, i]),
main  = paste("Variabel", i),
xlab  = "Kategori",
ylab  = "Frekuensi",
col   = "#4e79a7",
las   = 1
)
}
par(mfrow = c(1, 1))
# Cek crosstabulation antar variabel (contoh: variabel 1 vs 2)
cat("Crosstab Variabel 1 x Variabel 2:\n")
print(table(gmD$x[, 1], gmD$x[, 2]))
# Siapkan sufficient statistics untuk disCItest
allStat_D <- list(
dm      = gmD$x,                     # data diskrit
nlev    = apply(gmD$x, 2, max),      # jumlah level tiap variabel
adaptDF = FALSE
)
cat("Jumlah level per variabel:", allStat_D$nlev, "\n")
# Jalankan PC Algorithm dengan disCItest
set.seed(42)
pc_gmD <- pc(
suffStat  = allStat_D,
indepTest = disCItest,     # CI test untuk data diskrit (G² test)
p         = ncol(gmD$x),
alpha     = 0.01
)
